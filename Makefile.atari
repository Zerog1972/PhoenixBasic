# Makefile.atari - Compilation croisee Atari ST (m68k-atari-mint-gcc)
# ====================================================================
# Produit : build/atari/GFABASIC.PRG (executable TOS)
#
# Toolchain : MSYS2 mingw-w64-x86_64-m68k-atari-mint
#             (gcc 68000 + binutils + mintlib)
#
# ABI : -mlong (int = 32 bits, ABI mintlib moderne)
#       -m68000 (processeur 68000 de base, compatible ST/STE)
#
# NOTE IMPORTANTE : le code source suppose int = 32 bits partout
# (tailles de buffers, index de tableaux, sscanf, etc.). L'ABI
# historique TOS "-mshort" (int = 16 bits) CASSERAIT le code.
# On utilise donc "-mlong". Pour cibler l'ABI historique, il
# faudrait d'abord auditer le code (voir TODO).
#
# Usage :
#   Windows  : build_atari.bat
#   MSYS2    : make -f Makefile.atari
#   Nettoyer : make -f Makefile.atari clean
# ====================================================================

# --- Compilateur croise ---
CC       = m68k-atari-mintelf-gcc
AR       = m68k-atari-mintelf-ar
RANLIB   = m68k-atari-mintelf-ranlib
STRIP    = m68k-atari-mintelf-strip

# --- Chemins toolchain (MSYS2 + archives tho-otto.de) ---
MINT_SYSROOT = /mingw64/m68k-atari-mintelf/sys-root
MINT_INC     = $(MINT_SYSROOT)/usr/include
MINT_LIB     = $(MINT_SYSROOT)/usr/lib

# --- Options de compilation ---
# -std=c89   : C89 strict
# -pedantic-errors : erreurs pour toute deviation C89
# -DGFA_TARGET_MINT : active la branche osbind.h/_DTA/_base de os_layer.c
# -mnoshort  : ABI mintlib (int = 32 bits) — NECESSAIRE pour ce code
# -m68000    : 68000 nu (ST/STE)
# -fno-common : evite les bugs de sections communes en TOS
# -Os        : optimise la taille (RAM Atari ST limitee)
CFLAGS   = -std=c89 -Wall -Wextra -Os \
           -mnoshort -m68000 -fno-common \
           -DGFA_TARGET_MINT \
           -I$(MINT_INC)
LDFLAGS  = -L$(MINT_LIB)

# --- Include paths ---
INCLUDES = -Isrc/utils -Isrc/builtins -Isrc/io -Isrc/events -Isrc/sound \
           -Isrc/tos -Isrc/runtime -Isrc/memory -Isrc/lexer -Isrc/parser \
           -Isrc/codegen -Isrc/graphics

# --- Repertoires ---
BUILDDIR = build/atari

# --- Sources ---
SRCS = src/utils/os_layer.c src/builtins/strings.c src/builtins/gfamath.c \
       src/builtins/bit_ops.c \
       src/io/files.c src/events/events.c src/sound/sound.c src/tos/tos.c \
       src/runtime/runtime.c src/memory/memory.c \
       src/lexer/keywords.c src/lexer/lexer.c \
       src/parser/ast.c src/parser/parser.c \
       src/codegen/codegen.c \
       src/graphics/gfx.c

OBJS = $(patsubst src/%.c,$(BUILDDIR)/%.o,$(SRCS))

# --- Executable TOS ---
APP = $(BUILDDIR)/GFABASIC.PRG

.PHONY: all app clean

all: app
	@echo "=========================================="
	@echo " GFA Basic 3.5 - $(APP)"
	@echo " Executable TOS Atari ST cree."
	@echo "=========================================="

app: $(OBJS) src/main.c
	-@mkdir -p $(BUILDDIR)
	$(CC) $(CFLAGS) $(LDFLAGS) $(INCLUDES) -o $(APP) src/main.c $(OBJS) -lm
	-$(STRIP) $(APP)
	@echo "PRG cree : $(APP)"
	@echo "Taille  :"
	@wc -c < $(APP) | tr -d ' ' | xargs -I{} echo "  {} octets"
	@file $(APP)

# Regle generique C -> .o
$(BUILDDIR)/%.o: src/%.c
	-@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

clean:
	-rm -rf $(BUILDDIR)