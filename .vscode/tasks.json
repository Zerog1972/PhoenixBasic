{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build C89",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-std=c89",
        "-pedantic-errors",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}